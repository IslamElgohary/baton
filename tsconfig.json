{
  // Main process, preload, shared types, tests and tooling: Node, no DOM. The renderer has its own
  // src/renderer/tsconfig.json (DOM), so neither side can use the other's globals by accident.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/main", "src/preload", "src/shared", "test", "e2e", "electron.vite.config.ts"]
}
